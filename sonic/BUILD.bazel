cc_library(
    name = "sonic",
    srcs = glob([
        "src/sonic_crypto/src/sonic/crypto/impl/openssl/**/*.cpp",
    ]),
    hdrs = glob([
        "src/*/src/**/*.hpp",
        "src/*/src/**/*.h",
    ]),
    includes = [
        "src/sonic_util/src",
        "src/sonic_obliv/src",
        "src/sonic_sortshuffle/src",
        "src/sonic_threads/src",
        "src/sonic_storage/src",
        "src/sonic_crypto/src",
        "src/sonic_oram/src",
    ],
    defines = ["SONIC_CRYPTO_BACKEND_OPENSSL=1"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++20", "-Wno-unused-parameter", "-Wno-unused-variable", "-Wno-unused-function"],
    deps = [
        "@openssl.dev//:openssl",
    ],
)
